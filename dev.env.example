# Settings for idp_redirect_demo. Copy to dev.env (untracked) and fill in.
# KEY=VALUE per line; empty values use the default. A real environment
# variable with the same name overrides the file. DEV_ENV_FILE (environment
# only) points at a different file.

# ---- app ----------------------------------------------------------------
BASE_URL=http://localhost:8080
BIND_ADDR=127.0.0.1:8080
INSTITUTIONS_FILE=mock/approved_institutions.json
# Other origins that may read /v1/tms/institutions: comma-separated
# https://host[:port] values, or * for any. Empty -> same-origin only.
CORS_ALLOWED_ORIGINS=

# ---- Globus Auth ----------------------------------------------------------
# Required unless GLOBUS_MOCK=true. Redirect URI on the Globus app:
# <BASE_URL>/login/callback
GLOBUS_CLIENT_ID=
GLOBUS_CLIENT_SECRET=
# true -> built-in mock Globus (also stands in for Tapis); no credentials needed
GLOBUS_MOCK=

# ---- Tapis OAuth2 (TaccTapis entry; optional) -----------------------------
TAPIS_BASE_URL=https://tacc.tapis.io
TAPIS_CLIENT_ID=
TAPIS_CLIENT_SECRET=
# The callback registered for the Tapis client; default <BASE_URL>/login/callback
TAPIS_CALLBACK_URL=

# ---- Test OIDC provider under /idp (see README) ---------------------------
IDP_DOMAIN=tacc.utexas.edu
IDP_CLIENT_ID=globus-auth-client
# Empty -> a random secret per run (printed at startup)
IDP_CLIENT_SECRET=
# Comma-separated; the mock callback is always added
IDP_REDIRECT_URIS=https://auth.globus.org/p/authenticate/callback
IDP_SIGNING_KEY=idp_signing_key.pem
